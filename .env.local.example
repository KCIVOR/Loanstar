NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Transactional email: configure SMTP under Admin → System Config (not env).
# Supabase Auth emails (confirm/reset) use Auth SMTP in the Supabase dashboard.
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@yourcompany.com
# Off by default in production (always on outside it). Set to "true" only
# for the duration of a demo, to show the fake-data autofill button on
# application forms — then unset it. Never leave this on for the live site.
NEXT_PUBLIC_ENABLE_AUTOFILL=false
# Trusted public origin for current-inbox email approval (required in production
# unless VERCEL_PROJECT_PRODUCTION_URL is configured). No trailing path.
EMAIL_CHANGE_APP_ORIGIN=http://localhost:3000
